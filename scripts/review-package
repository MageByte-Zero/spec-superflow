#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not HEAD~1) keeps multi-commit
# tasks intact.
#
# Usage: review-package BASE HEAD [OUTFILE]
# Default OUTFILE: <change>/.superpowers/sdd/plans/<plan-identity>/workspace/review-<base7>..<head7>.diff
# Set SSF_CHANGE_DIR when running outside the change directory. When it is not
# set, the script resolves the sole persisted execution plan below ./changes.
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: review-package BASE HEAD [OUTFILE]" >&2
  exit 2
fi

base=$1
head=$2

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  script_dir="$(cd "$(dirname "$0")" && pwd)"
  if [ -n "${SSF_CHANGE_DIR:-}" ]; then
    change_dir="$SSF_CHANGE_DIR"
  elif [ -f ".superpowers/sdd/execution-plan.json" ]; then
    change_dir="$PWD"
  else
    plan_files=(changes/*/.superpowers/sdd/execution-plan.json)
    if [ ${#plan_files[@]} -ne 1 ] || [ ! -f "${plan_files[0]}" ]; then
      echo "set SSF_CHANGE_DIR or run from a change directory with one persisted execution plan" >&2
      exit 2
    fi
    change_dir="$(cd "$(dirname "$(dirname "$(dirname "${plan_files[0]}")")")" && pwd)"
  fi
  dir="$(node --input-type=module -e '
    import { pathToFileURL } from "node:url";
    const overlay = await import(pathToFileURL(process.argv[1]).href);
    const scope = overlay.getCurrentPlanScopedPaths(process.argv[2]);
    if (!scope) throw new Error("review-package requires a persisted execution plan");
    process.stdout.write(scope.workspace);
  ' "$script_dir/lib/sdd-overlay.mjs" "$change_dir")"
  out="$dir/review-$(git rev-parse --short "$base")..$(git rev-parse --short "$head").diff"
fi

mkdir -p "$(dirname "$out")"

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  git log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git diff -U10 "${base}..${head}"
} > "$out"

commits=$(git rev-list --count "${base}..${head}")
echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
